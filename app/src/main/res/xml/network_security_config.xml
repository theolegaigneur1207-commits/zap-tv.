<?xml version="1.0" encoding="utf-8"?>
<!-- Beaucoup de serveurs IPTV et Xtream sont en http : on les autorise. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
